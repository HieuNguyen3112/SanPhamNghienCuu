SESSION_SAME_SITE=lax
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173


SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173,localhost,127.0.0.1,spa.example.test
SANCTUM_EXPIRATION=60

# Có revoke token cũ ngay sau khi cấp mới không? (false = an toàn hơn)
TOKEN_REVOKE_OLD_ON_ROTATE=false

# Ngưỡng rotate (phút còn lại) — khi minutes_left <= 5 thì cấp token mới
TOKEN_REFRESH_THRESHOLD=5

