APP_NAME=SPNC
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://apibe.spnc.id.vn
FRONTEND_URL=https://quanlicongtrinh.spnc.id.vn

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info
BROADCAST_DRIVER=log

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=spnc
DB_USERNAME=postgres
DB_PASSWORD=

CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=240
SESSION_DOMAIN=.spnc.id.vn
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=none
CORS_ALLOWED_ORIGINS=https://quanlicongtrinh.spnc.id.vn
SANCTUM_STATEFUL_DOMAINS=quanlicongtrinh.spnc.id.vn,apibe.spnc.id.vn
SANCTUM_EXPIRATION=60
SANCTUM_REFRESH_THRESHOLD=5
SANCTUM_REVOKE_OLD_ON_ROTATE=false

MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="${APP_NAME}"

RUN_DB_SEED=false
DB_SEED_CLASS=

SPNC_RCLONE_BINARY=rclone
# Non-secret remote definition file path inside the runtime/container.
SPNC_RCLONE_CONFIG=storage/app/rclone/rclone.conf
# Optional fallback for platforms that can only provide env secrets, not mounted files.
# Base64 of the full rclone.conf content.
SPNC_RCLONE_CONFIG_BASE64=
# Preferred production auth mode: service account secret file mounted by the platform.
SPNC_RCLONE_SERVICE_ACCOUNT_FILE=
# Optional fallback for platforms that provide the service account JSON as an env secret.
# Base64 of the full Google service account JSON content.
SPNC_RCLONE_SERVICE_ACCOUNT_JSON_BASE64=
SPNC_RCLONE_DRIVE_IMPERSONATE=

SPNC_BACKUP_ENGINE=restic
SPNC_BACKUP_RESTIC_BINARY=restic
SPNC_BACKUP_REPOSITORY=rclone:spnc_gdrive:spnc-backups/restic-repo
SPNC_BACKUP_PASSWORD=
SPNC_BACKUP_DB_CONNECTION=pgsql
SPNC_BACKUP_PG_DUMP_BINARY=pg_dump
SPNC_BACKUP_PSQL_BINARY=psql
SPNC_BACKUP_MYSQLDUMP_BINARY=mysqldump
SPNC_BACKUP_MYSQL_BINARY=mysql
SPNC_BACKUP_HTTP_PROXY=
SPNC_BACKUP_HTTPS_PROXY=
SPNC_BACKUP_NO_PROXY=
SPNC_BACKUP_INCLUDE_PATHS=storage/app/evidence,storage/app/public
SPNC_BACKUP_EXCLUDE_PATHS=storage/framework,storage/logs,backend/vendor,frontend/node_modules,backend/node_modules,.git
SPNC_BACKUP_STATE_DIR=backup-runs
SPNC_BACKUP_WORKSPACE_DIR=backup-workspace
SPNC_BACKUP_RESTORE_DIR=backup-restores
SPNC_BACKUP_DOWNLOAD_DIR=backup-downloads
SPNC_BACKUP_SNAPSHOT_CACHE_FILE=backup-snapshots/cache.json
SPNC_BACKUP_EXPORT_ENABLED=true
SPNC_BACKUP_EXPORT_SYNC_TO_DRIVE=true
SPNC_BACKUP_EXPORT_FOLDER_NAME=exports
SPNC_BACKUP_EXPORT_TARGET=
SPNC_BACKUP_EXPORT_LOCAL_DIR=backup-exports/items
SPNC_BACKUP_EXPORT_INDEX_FILE=backup-exports/index.json
SPNC_BACKUP_SNAPSHOT_CACHE_MAX_ITEMS=200
SPNC_BACKUP_SNAPSHOT_CACHE_STALE_SECONDS=900
SPNC_BACKUP_SNAPSHOT_REFRESH_TIMEOUT_SECONDS=900
SPNC_BACKUP_SNAPSHOT_AUTO_REFRESH=true
SPNC_BACKUP_SNAPSHOT_REFRESH_INTERVAL_MINUTES=10
SPNC_BACKUP_FORGET_QUEUE_STALE_SECONDS=90
SPNC_BACKUP_FORGET_RUNNING_STALE_SECONDS=1800
SPNC_BACKUP_BACKUP_RUNNING_STALE_SECONDS=3600
SPNC_BACKUP_PRUNE_RUNNING_STALE_SECONDS=7200
SPNC_BACKUP_RESTORE_RUNNING_STALE_SECONDS=7200
SPNC_BACKUP_SCHEDULE_DAYS=1,4
SPNC_BACKUP_SCHEDULE_TIME=02:00
SPNC_BACKUP_PRUNE_TIME=03:00
SPNC_BACKUP_SCHEDULE_TIMEZONE=Asia/Ho_Chi_Minh
SPNC_BACKUP_KEEP_LAST=12
SPNC_BACKUP_KEEP_WEEKLY=8
SPNC_BACKUP_KEEP_MONTHLY=6
SPNC_BACKUP_RESTORE_CONFIRM_PHRASE=RESTORE
SPNC_BACKUP_RESTORE_CONFIRM_PHRASE_LEGACY=KHOI_PHUC_DU_LIEU
SPNC_BACKUP_ALLOW_LIVE_RESTORE=false
SPNC_BACKUP_ALLOW_LIVE_RESTORE_IN_PRODUCTION=false
SPNC_BACKUP_RUN_LOG_MAX_LINES=80
SPNC_BACKUP_RUN_LOG_MAX_CHARS=500

SPNC_EVIDENCE_STORAGE_DRIVER=rclone
SPNC_EVIDENCE_DRIVE_TARGET=rclone:spnc_gdrive:spnc-backups/declaration-evidence
SPNC_EVIDENCE_ALLOW_BACKUP_REPOSITORY_FALLBACK=false
SPNC_EVIDENCE_DRIVE_FOLDER=declaration-evidence
SPNC_EVIDENCE_REQUIRE_WRITABLE_RCLONE_CONFIG=false
SPNC_EVIDENCE_HTTP_PROXY=
SPNC_EVIDENCE_HTTPS_PROXY=
SPNC_EVIDENCE_NO_PROXY=localhost,127.0.0.1,::1
SPNC_EVIDENCE_CREATE_FOLDER_BEFORE_UPLOAD=false
SPNC_EVIDENCE_RCLONE_RETRIES=3
SPNC_EVIDENCE_RCLONE_LOW_LEVEL_RETRIES=5
SPNC_EVIDENCE_RCLONE_RETRIES_SLEEP_SECONDS=2
SPNC_EVIDENCE_RCLONE_CONNECT_TIMEOUT_SECONDS=15
SPNC_EVIDENCE_RCLONE_IO_TIMEOUT_SECONDS=60
SPNC_EVIDENCE_MKDIR_TIMEOUT_SECONDS=120
SPNC_EVIDENCE_UPLOAD_TIMEOUT_SECONDS=600
SPNC_EVIDENCE_DOWNLOAD_TIMEOUT_SECONDS=600
SPNC_EVIDENCE_DELETE_TIMEOUT_SECONDS=180
SPNC_EVIDENCE_LOCAL_DISK=local
SPNC_EVIDENCE_LOCAL_DIR=evidence/declarations
SPNC_EVIDENCE_HOT_DISK=local
SPNC_EVIDENCE_HOT_DIR=evidence/hot-cache
SPNC_EVIDENCE_HOT_CACHE_TTL_DAYS=14
SPNC_EVIDENCE_HOT_CACHE_MAX_BYTES=2147483648
SPNC_EVIDENCE_HOT_CACHE_CONTROL_SECONDS=3600
SPNC_EVIDENCE_HOT_CACHE_CLEANUP_TIME=04:30
SPNC_EVIDENCE_COLD_SYNC_CONNECTION=sync
SPNC_EVIDENCE_COLD_SYNC_QUEUE=evidence-sync
SPNC_EVIDENCE_COLD_SYNC_AFTER_RESPONSE=true
